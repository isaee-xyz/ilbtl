# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
TRUST_PROXY=true

# Comma-separated origins if the API is called cross-origin (optional with Docker/nginx same-host)
# ALLOWED_ORIGINS=https://your-domain.com

# Docker published port for the frontend container (host → container :80)
APP_PORT=80

# Docker image registry — set in prod for versioned deploys and rollback
# Example: REGISTRY=your-registry.example.com/ilbtl  DEPLOY_TAG=v1.2.3
REGISTRY=local
DEPLOY_TAG=dev

# ── Database: Firebase Firestore (Admin SDK) ─────────────────────────────────
# The backend uses Cloud Firestore via the Firebase Admin SDK.
#
# Create a service account: Firebase Console → Project Settings → Service accounts
# → "Generate new private key". Then provide the credentials ONE of two ways:
#
#  1. (Recommended, works on Vercel) Paste the entire downloaded JSON as a single
#     line into FIREBASE_SERVICE_ACCOUNT. Escaped "\n" in the private key is fine —
#     the app un-escapes it automatically.
#  2. (Local only) Point GOOGLE_APPLICATION_CREDENTIALS at the key file path.
#
# NEVER commit the key file or paste real values into this example.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"il-btl-lead-collection","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@il-btl-lead-collection.iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}
# FIREBASE_PROJECT_ID=il-btl-lead-collection
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# ── Gupshup WhatsApp ─────────────────────────────────────────────────────────
GUPSHUP_API_KEY=your_api_key_here
GUPSHUP_SOURCE=
GUPSHUP_APP_NAME=
GUPSHUP_TEMPLATE_ID=

GUPSHUP_OTP_API_KEY=
GUPSHUP_OTP_SOURCE=
GUPSHUP_OTP_APP_NAME=
GUPSHUP_OTP_TEMPLATE_ID=

GUPSHUP_SMS_USERID=your_userid_here
GUPSHUP_SMS_PASSWORD=your_password_here
GUPSHUP_SMS_URL=

# Gupshup inbound webhook — same value in callback URL ?secret=
GUPSHUP_WEBHOOK_SECRET=change-me-for-production

# ── LeadSquared (LSQ) ────────────────────────────────────────────────────────
LSQ_ENABLED=false
LSQ_API_HOST=api-in21.leadsquared.com
LSQ_API_PATH=/v2/ProspectActivity.svc/CreateCustom
LSQ_ACCESS_KEY=
LSQ_SECRET_KEY=
# Fixed campaign values (match LSQ curl — change only if marketing updates)
# LSQ_SOURCE_MEDIUM=Whatsapp
# LSQ_SOURCE=Brand Lead
# LSQ_MX_GRADE=12
# LSQ_MX_PRIMARY_TARGET_EXAM=NEET
# mx_Last_Consent_Date is set automatically to current India time on each push
# LSQ_SOURCE_CAMPAIGN=Re NEET 2026
# LSQ_SOURCE_CONTENT=Re NEET 2026
# LSQ_MX_USER_TYPE=Parent
# LSQ_ACTIVITY_EVENT=203
# LSQ_ACTIVITY_NOTE=Re NEET 2026

# ── Frontend (Vite build) — Firebase Web config ──────────────────────────────
# These are the PUBLIC client config values (safe to ship in the browser bundle;
# security is enforced by Firebase Auth authorized domains + Firestore rules).
# On Vercel, set them as Environment Variables so the build picks them up.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Leave EMPTY on Vercel — the frontend calls /api on the same origin and
# vercel.json routes it to the serverless Express function.
VITE_API_URL=
